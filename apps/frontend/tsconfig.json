{
  "extends": ["../../tsconfig.base.json"],
  "include": [
    ".astro/types.d.ts",
    "src",
    "src/**/*.json",
    "e2e",
    "astro.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Starlight ships TypeScript rather than declarations, and its own sources trip
    // this flag. Re-enable once it publishes `.d.ts` files.
    "noPropertyAccessFromIndexSignature": false,
    "resolveJsonModule": true
  }
}
