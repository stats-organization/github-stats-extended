{
  "extends": ["../../tsconfig.base.json"],
  "include": [
    "src/**/*.ts",
    "vitest.config.ts",
    "vitest.config.bench.ts",
    "vitest.config.e2e.ts"
  ],
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Allow TS files to import the remaining JS files
    "allowJs": true,
    "erasableSyntaxOnly": true
  }
}
